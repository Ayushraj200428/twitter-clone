# Clerk publishable key — copy from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL for local development.
# - iOS Simulator / web browser: use http://localhost:5001
# - Android Emulator: the app auto-replaces localhost with 10.0.2.2 (see utils/api.ts)
