PORT=5001
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Clerk authentication keys — copy from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Arcjet security key — copy from https://arcjet.com
ARCJET_KEY=ajkey_...
ARCJET_ENV=development

# Cloudinary image storage — copy from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=...
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...

# CORS: comma-separated list of allowed origins for the mobile/web frontend.
# Leave blank to allow all origins (fine for local development).
# Example for Expo dev server: CORS_ORIGIN=http://localhost:8081,exp://192.168.1.100:8081
CORS_ORIGIN=
